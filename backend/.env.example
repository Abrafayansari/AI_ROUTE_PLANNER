# Server-side Neon PostgreSQL connection string (NEVER expose to frontend or commit secrets)
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require

# Optional server-side Google Maps Platform API key (NEVER expose to React)
GOOGLE_MAPS_API_KEY=

# Free OSRM / OpenStreetMap routing server (configurable for self-hosted instance)
OSRM_BASE_URL=https://router.project-osrm.org
OSRM_PROFILE=driving

# Optional server-side OpenRouteService API key (used only if OSRM fails)
OPENROUTESERVICE_API_KEY=

# Flask runtime settings
FLASK_ENV=development
PORT=5000
FRONTEND_URL=http://localhost:5173,http://localhost:3000
