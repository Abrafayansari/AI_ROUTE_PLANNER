# DATABASE_URL: Server-side only Neon pooled PostgreSQL connection URL.
# Configure this in AI Studio's server-side Secrets panel (never expose with VITE_ prefix).
# Example format: postgresql://user:password@ep-example-pooler.region.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=""

# GOOGLE_MAPS_API_KEY: Optional server-side Google Maps Routes API key (never expose with VITE_ prefix).
# When unset, routing automatically uses free OSRM / OpenStreetMap.
GOOGLE_MAPS_API_KEY=""

# VITE_GOOGLE_MAPS_API_KEY: Optional browser-restricted Maps JavaScript API key (Leaflet map is active when unset).
VITE_GOOGLE_MAPS_API_KEY=""

# OSRM_BASE_URL / OSRM_PROFILE: Free OpenStreetMap OSRM routing server (configurable for self-hosted OSRM).
OSRM_BASE_URL="https://router.project-osrm.org"
OSRM_PROFILE="driving"

# OPENROUTESERVICE_API_KEY: Optional server-side OpenRouteService free-tier key (secondary fallback if OSRM fails).
OPENROUTESERVICE_API_KEY=""

# GEMINI_API_KEY: Server-side environment variable (optional, not required for route algorithms).
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: Automatically injected at runtime by the hosting environment.
APP_URL="MY_APP_URL"
