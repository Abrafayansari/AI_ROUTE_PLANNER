# DATABASE_URL: Server-side only Neon pooled PostgreSQL connection URL.
# Configure this in AI Studio's server-side Secrets panel (never expose with VITE_ prefix).
# Example format: postgresql://user:password@ep-example-pooler.region.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=""

# GEMINI_API_KEY: Server-side environment variable (optional, not required for route algorithms).
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: Automatically injected at runtime by the hosting environment.
APP_URL="MY_APP_URL"
