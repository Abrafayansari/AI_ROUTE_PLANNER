{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "dev:frontend": "npm --prefix frontend run dev",
    "dev:gateway": "tsx --env-file=.env server.ts",
    "dev:backend": "node -e \"const {spawn}=require('child_process'),fs=require('fs');const py=fs.existsSync('backend/.venv/Scripts/python.exe')?'backend/.venv/Scripts/python.exe':'backend/.venv/bin/python';const p=spawn(py,['run.py'],{cwd:'backend',env:{...process.env,PYTHONUNBUFFERED:'1',PORT:'5000'},stdio:'inherit'});process.on('SIGINT',()=>p.kill());process.on('SIGTERM',()=>p.kill())\"",
    "start": "tsx server.ts",
    "build:server": "esbuild server.ts --platform=node --format=esm --target=node20 --outfile=dist/server.js",
    "build": "npm --prefix frontend run build && npm run build:server",
    "preview": "npm --prefix frontend run preview",
    "clean": "rm -rf dist frontend/dist server.js",
    "lint": "npm --prefix frontend run lint",
    "test": "node -e \"const {spawnSync}=require('child_process'),fs=require('fs');const py=fs.existsSync('backend/.venv/Scripts/python.exe')?'backend/.venv/Scripts/python.exe':'backend/.venv/bin/python';process.exit(spawnSync(py,['-m','pytest','-v','backend/tests'],{stdio:'inherit'}).status||0)\""
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@neondatabase/serverless": "^1.2.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^6.1.1",
    "axios": "^1.21.1",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "react-router-dom": "^7.18.6",
    "recharts": "^3.11.0",
    "vite": "^8.3.0",
    "vitest": "^5.1.1",
    "ws": "^8.23.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2",
    "@types/express": "^4.17.21"
  }
}
